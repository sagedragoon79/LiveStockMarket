<?xml version="1.0" encoding="utf-8"?>
<!--
  Live-Stock Market — Farthest Frontier mod (MelonLoader 0.7 + HarmonyLib, FF v1.1.x Mono).
  Scaffold modeled on BoatKeys/TheDockmastersDingyBoathouse.csproj.

  Build:   dotnet msbuild -restore -p:Configuration=Debug LiveStockMarket.csproj
  Deploy:  the CopyToMods target copies the DLL into Mods/ after every build (non-fatal).
           ./deploy.sh is the fallback that waits for Farthest Frontier to exit first.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3F6A9C2E-7B14-4D58-9A0E-5C2D8E1F4B77}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>LiveStockMarket</RootNamespace>
    <AssemblyName>LiveStockMarket</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <!-- Game install (post PC-flash 2026: everything lives on C:) -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Farthest Frontier\Farthest Frontier (Mono)</GameDir>
    <ManagedDir>$(GameDir)\Farthest Frontier_Data\Managed</ManagedDir>
    <CopyToModsEnabled Condition="'$(CopyToModsEnabled)' == ''">true</CopyToModsEnabled>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- MelonLoader (Mono / net35 build) + Harmony -->
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net35\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net35\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Game assemblies. ES2 (Easy Save 2: ES2Writer / ES2Reader) lives in firstpass. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Texture2D.LoadImage (wool icon) and Input (test hotkey) -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- TextMeshPro (injected button labels / tooltips) -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="LiveStockMarket.cs" />
    <Compile Include="KeepClarityIntegration.cs" />
    <Compile Include="Systems\GoatBarnModeStore.cs" />
    <Compile Include="Systems\GoatBarnNaming.cs" />
    <Compile Include="Systems\WoolItem.cs" />
    <Compile Include="Systems\ModIcons.cs" />
    <Compile Include="Systems\ModItems.cs" />
    <Compile Include="Systems\GarmentItems.cs" />
    <Compile Include="Systems\GarmentRecipes.cs" />
    <Compile Include="Systems\WoolIcon.cs" />
    <Compile Include="Systems\WoolTrade.cs" />
    <Compile Include="Systems\WoolTestHotkey.cs" />
    <Compile Include="Systems\SheepShearing.cs" />
    <Compile Include="Patches\GoatBarnSaveLoadPatches.cs" />
    <Compile Include="Patches\GoatBarnLoadPatches.cs" />
    <Compile Include="Patches\GoatBarnNamePatches.cs" />
    <Compile Include="Patches\GoatBarnModeButtonPatches.cs" />
    <Compile Include="Patches\LocalizationPatches.cs" />
    <Compile Include="Patches\WoolItemPatches.cs" />
    <Compile Include="Patches\WoolStoragePatches.cs" />
    <Compile Include="Patches\ShearingPatches.cs" />
    <Compile Include="Patches\GarmentPatches.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <!-- Self-contained single-DLL install: the wool icon rides inside the assembly.
       A loose Mods/LiveStockMarket/wool_icon.png still overrides it (artist hot-swap). -->
  <ItemGroup>
    <EmbeddedResource Include="art\wool_icon.png">
      <LogicalName>LSM.wool_icon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="art\winter_boots.png">
      <LogicalName>LSM.winter_boots.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="art\winter_cloak.png">
      <LogicalName>LSM.winter_cloak.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="art\woolen_clothes.png">
      <LogicalName>LSM.woolen_clothes.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Best-effort copy into Mods/. Non-fatal so a build never fails on a locked file. -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(CopyToModsEnabled)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods\" ContinueOnError="true" />
  </Target>
</Project>
